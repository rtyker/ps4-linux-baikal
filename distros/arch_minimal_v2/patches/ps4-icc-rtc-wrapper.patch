diff --git a/drivers/ps4/aeolia.h b/drivers/ps4/aeolia.h
index a4262732d..c65ccd1cd 100644
--- a/drivers/ps4/aeolia.h
+++ b/drivers/ps4/aeolia.h
@@ -113,6 +113,13 @@ static inline int apcie_irqnum(struct apcie_dev *sc, int index)
 
 int apcie_icc_cmd(u8 major, u16 minor, const void *data, u16 length,
 	    void *reply, u16 reply_length);
+
+/* Wrapper de retry para ICC lento (RTC), transparente de console.
+ * Veja comentario completo em baikal.h — definido em ps4-bpcie-icc.c. */
+#define PS4_ICC_RTC_RETRIES		100
+#define PS4_ICC_RTC_RETRY_DELAY_MS	50
+int ps4_icc_rtc_cmd(u8 major, u16 minor, const void *data, u16 length,
+		    void *reply, u16 reply_length);
 int apcie_uart_init(struct apcie_dev *sc);

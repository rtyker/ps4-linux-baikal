+
+static ssize_t dma_min_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val < 4)
+		return -EINVAL;
+	dma_min = val;
+	return count;
+}

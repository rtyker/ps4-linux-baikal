+static bool baikal_is_bar2_window(loff_t pos, size_t len)
+{
+	loff_t bar2_start = BAIKAL_DEV_BAR2_OFF;
+	loff_t bar2_end = BAIKAL_DEV_BAR2_OFF + BAIKAL_DEV_BAR2_WIN;
+
+	return (pos >= bar2_start) && (pos + len <= bar2_end);
+}
+
+/*
+ * Work out how much of the next stretch can go through DMA.
+ * Returns the number of bytes (a multiple of 4, at least dma_min) that one DMA
+ * transfer can cover starting at @pos, or 0 if the stretch must use the CPU.
+ * An unaligned start gets a CPU head of 1 to 3 bytes: *@chunk is shortened to
+ * that head so the next loop iteration starts aligned. The 1 to 3 byte tail
+ * left after the aligned middle also falls back to the CPU.
+ */
+static size_t baikal_dma_span(struct baikal_mem_dev *dev, loff_t pos,
+			      size_t *chunk)
+{
+	size_t head, len;
+
+	if (!use_dma || !dev->dma_enabled || !dev->dma_chan ||
+	    !baikal_is_bar2_window(pos, *chunk))
+		return 0;
+
+	head = (4 - (pos & 3)) & 3;
+	if (head) {
+		/* Only split off a head if DMA can take the rest */
+		if (*chunk >= head + dma_min)
+			*chunk = head;
+		return 0;
+	}
+
+	len = ALIGN_DOWN(*chunk, 4);
+	return len >= dma_min ? len : 0;
+}

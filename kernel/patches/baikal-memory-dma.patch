+static ssize_t use_dma_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", use_dma);
+}
+
+static ssize_t use_dma_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct baikal_mem_dev *bm = dev_get_drvdata(dev);
+	bool val;
+	int ret;
+
+	if (!bm)
+		return -ENODEV;
+
+	ret = kstrtobool(buf, &val);
+	if (ret)
+		return ret;
+
+	mutex_lock(&bm->lock);
+
+	if (val && !use_dma) {
+		/* Habilitando DMA */
+		use_dma = true;
+		if (!bm->dma_enabled) {
+			/* Tentar obter canal se ainda não temos */
+			if (!bm->dma_chan && !bm->dma_disabled_perm) {
+				ret = baikal_dma_request_channel(bm);
+				if (ret == 0) {
+					bm->dma_enabled = true;
+					init_completion(&bm->dma_comp);
+					baikal_dma_update_state(bm);
+					dev_info(dev, "[BAIKAL] DMA habilitado via sysfs\n");
+				} else {
+					dev_info(dev, "[BAIKAL] Não foi possível obter canal DMA: %d\n", ret);
+				}
+			} else if (bm->dma_disabled_perm) {
+				dev_info(dev, "[BAIKAL] DMA desligado permanentemente por erro anterior\n");
+				use_dma = false;
+				ret = -EPERM;
+			} else {
+				bm->dma_enabled = true;
+				init_completion(&bm->dma_comp);
+				baikal_dma_update_state(bm);
+			}
+		}
+	} else if (!val && use_dma) {
+		/* Desabilitando DMA */
+		use_dma = false;
+		if (bm->dma_enabled) {
+			bm->dma_enabled = false;
+			baikal_dma_release_channel(bm);
+			baikal_dma_free_bounce(bm);
+			baikal_dma_update_state(bm);
+			dev_info(dev, "[BAIKAL] DMA desabilitado via sysfs\n");
+		}
+	}
+
+	mutex_unlock(&bm->lock);
+	return ret ? ret : count;
+}
+
+static ssize_t dma_min_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", dma_min);

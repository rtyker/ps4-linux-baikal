+/* ------------------------------------------------------------------------- */
+/* Helpers de DMA                                                            */
+/* ------------------------------------------------------------------------- */
+
+static void baikal_dma_update_state(struct baikal_mem_dev *dev)
+{
+	if (!dev->dma_enabled) {
+		if (dev->dma_disabled_perm)
+			snprintf(dev->dma_state, sizeof(dev->dma_state), "desligado: erro anterior");
+		else if (!dev->dma_chan)
+			snprintf(dev->dma_state, sizeof(dev->dma_state), "sem canal");
+		else
+			snprintf(dev->dma_state, sizeof(dev->dma_state), "off");
+	} else if (dev->dma_chan) {
+		/* baikal-dmac channel i maps to DMAC(i+1): 0 is DMAC1 (IRQ), 1 is DMAC2 (polling) */
+		snprintf(dev->dma_state, sizeof(dev->dma_state), "ativo DMAC%d",
+			 dev->dma_chan->chan_id + 1);
+	} else {
+		snprintf(dev->dma_state, sizeof(dev->dma_state), "sem canal");
+	}
+}
+
+static int baikal_dma_request_channel(struct baikal_mem_dev *dev)
+{
+	dma_cap_mask_t mask;
+	struct dma_chan *chan;
+
+	if (dev->dma_chan)
+		return 0;
+
+	if (dev->dma_disabled_perm)
+		return -ENODEV;
+
+	dma_cap_zero(mask);
+	dma_cap_set(DMA_MEMCPY, mask);
+
+	chan = dma_request_channel(mask, NULL, NULL);
+	if (!chan) {
+		dev_info(&dev->pdev->dev, "[BAIKAL] Nenhum canal DMA_MEMCPY disponível\n");
+		return -ENODEV;
+	}
+
+	/* Verificar se o canal pertence ao baikal-dmac (PCI 104d:90dc) */
+	if (chan->device->dev && chan->device->dev->driver) {
+		struct pci_dev *pdev = to_pci_dev(chan->device->dev);
+		if (pdev->vendor != 0x104d || pdev->device != 0x90dc) {
+			dev_info(&dev->pdev->dev, "[BAIKAL] Canal DMA não é do baikal-dmac (vendor=0x%04x device=0x%04x), liberando\n",
+				 pdev->vendor, pdev->device);
+			dma_release_channel(chan);
+			return -ENODEV;
+		}
+	}
+
+	dev->dma_chan = chan;
+	dev_info(&dev->pdev->dev, "[BAIKAL] Canal DMA obtido: %s\n", dma_chan_name(chan));
+	return 0;
+}
+
+static void baikal_dma_release_channel(struct baikal_mem_dev *dev)
+{
+	if (dev->dma_chan) {
+		dev_info(&dev->pdev->dev, "[BAIKAL] Liberando canal DMA\n");
+		dma_release_channel(dev->dma_chan);
+		dev->dma_chan = NULL;
+	}
+}
+
+/*
+ * Try to get a DMA channel on demand, so DMA starts being used when baikal-dmac
+ * is loaded after this driver. Rate limited to one attempt per second.
+ * Caller holds dev->lock.
+ */
+static void baikal_dma_try_enable(struct baikal_mem_dev *dev)
+{
+	if (!use_dma || dev->dma_enabled || dev->dma_disabled_perm)
+		return;
+	if (time_before(jiffies, dev->dma_retry_at))
+		return;
+	dev->dma_retry_at = jiffies + HZ;
+
+	if (baikal_dma_request_channel(dev))
+		return;
+
+	init_completion(&dev->dma_comp);
+	dev->dma_enabled = true;
+	baikal_dma_update_state(dev);
+	dev_info(&dev->pdev->dev, "[BAIKAL] DMA habilitado sob demanda\n");
+}
+
+static int baikal_dma_alloc_bounce(struct baikal_mem_dev *dev)
+{
+	if (dev->dma_bounce_virt)
+		return 0;
+
+	if (!dev->dma_chan || !dev->dma_chan->device || !dev->dma_chan->device->dev)
+		return -ENODEV;
+
+	dev->dma_bounce_virt = dma_alloc_coherent(dev->dma_chan->device->dev,
+						  BAIKAL_DMA_BOUNCE_SIZE,
+						  &dev->dma_bounce_phys,
+						  GFP_KERNEL);
+	if (!dev->dma_bounce_virt) {
+		dev_err(&dev->pdev->dev, "[BAIKAL] Falha ao alocar bounce buffer DMA\n");
+		return -ENOMEM;
+	}
+
+	dev->dma_bounce_size = BAIKAL_DMA_BOUNCE_SIZE;
+	dev_info(&dev->pdev->dev, "[BAIKAL] Bounce buffer DMA alocado: virt=%p phys=%pad size=%zu\n",
+		 dev->dma_bounce_virt, &dev->dma_bounce_phys, dev->dma_bounce_size);
+	return 0;
+}
+
+static void baikal_dma_free_bounce(struct baikal_mem_dev *dev)
+{
+	if (dev->dma_bounce_virt && dev->dma_chan && dev->dma_chan->device && dev->dma_chan->device->dev) {
+		dma_free_coherent(dev->dma_chan->device->dev,
+				  dev->dma_bounce_size,
+				  dev->dma_bounce_virt,
+				  dev->dma_bounce_phys);
+		dev->dma_bounce_virt = NULL;
+		dev->dma_bounce_phys = 0;
+		dev->dma_bounce_size = 0;
+	}
+}
+
+static void baikal_dma_callback(void *data)
+{
+	struct baikal_mem_dev *dev = data;
+	complete(&dev->dma_comp);
+}
+
+static int baikal_dma_wait_completion(struct baikal_mem_dev *dev)
+{
+	unsigned long timeout = msecs_to_jiffies(3000); /* 3s, maior que timeout do DMAC (2s) */
+	int ret = wait_for_completion_timeout(&dev->dma_comp, timeout);
+	if (ret == 0) {
+		dev_err(&dev->pdev->dev, "[BAIKAL] Timeout esperando conclusão DMA\n");
+		return -ETIMEDOUT;
+	}
+	return 0;
+}
+
+static int baikal_dma_do_transfer(struct baikal_mem_dev *dev, dma_addr_t dst, dma_addr_t src,
+				   size_t len, enum dma_transfer_direction dir)
+{
+	struct dma_async_tx_descriptor *tx;
+	dma_cookie_t cookie;
+	int ret;
+
+	if (!dev->dma_chan)
+		return -ENODEV;
+
+	reinit_completion(&dev->dma_comp);
+
+	tx = dmaengine_prep_dma_memcpy(dev->dma_chan, dst, src, len, DMA_CTRL_ACK | DMA_PREP_INTERRUPT);
+	if (!tx) {
+		dev_err(&dev->pdev->dev, "[BAIKAL] prep_dma_memcpy falhou (len=%zu)\n", len);
+		return -EIO;
+	}
+
+	tx->callback = baikal_dma_callback;
+	tx->callback_param = dev;
+
+	cookie = dmaengine_submit(tx);
+	if (dma_submit_error(cookie)) {
+		dev_err(&dev->pdev->dev, "[BAIKAL] dmaengine_submit falhou\n");
+		return -EIO;
+	}
+
+	dma_async_issue_pending(dev->dma_chan);
+
+	ret = baikal_dma_wait_completion(dev);
+	if (ret) {
+		/* Timeout ou erro — tentar terminar e refazer pela CPU */
+		dmaengine_terminate_sync(dev->dma_chan);
+		return ret;
+	}
+
+	/* Verificar status da transferência */
+	ret = dmaengine_tx_status(dev->dma_chan, cookie, NULL);
+	if (ret == DMA_TRANS_ABORTED) {
+		dev_err(&dev->pdev->dev, "[BAIKAL] Transferência DMA abortada pelo hardware\n");
+		return -EIO;
+	}
+
+	return 0;
+}

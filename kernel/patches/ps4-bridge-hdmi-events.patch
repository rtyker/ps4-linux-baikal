--- a/drivers/ps4/ps4-bpcie-icc.c
+++ b/drivers/ps4/ps4-bpcie-icc.c
@@ -53,6 +53,75 @@ static void dump_message(struct bpcie_dev *sc, int offset)
 	}
 }
 
+/* One consumer for ICC events of a given major (e.g. the HDMI bridge, 0x10). */
+static struct {
+	spinlock_t lock;
+	bool used;
+	u8 major;
+	bpcie_icc_event_fn fn;
+	void *ctx;
+} icc_event_slot = { .lock = __SPIN_LOCK_UNLOCKED(icc_event_slot.lock) };
+
+int bpcie_icc_register_event_handler(u8 major, bpcie_icc_event_fn fn, void *ctx)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!fn)
+		return -EINVAL;
+
+	spin_lock_irqsave(&icc_event_slot.lock, flags);
+	if (icc_event_slot.used) {
+		ret = -EBUSY;
+	} else {
+		icc_event_slot.used = true;
+		icc_event_slot.major = major;
+		icc_event_slot.fn = fn;
+		icc_event_slot.ctx = ctx;
+	}
+	spin_unlock_irqrestore(&icc_event_slot.lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(bpcie_icc_register_event_handler);
+
+void bpcie_icc_unregister_event_handler(u8 major)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&icc_event_slot.lock, flags);
+	if (icc_event_slot.used && icc_event_slot.major == major) {
+		icc_event_slot.used = false;
+		icc_event_slot.fn = NULL;
+		icc_event_slot.ctx = NULL;
+	}
+	spin_unlock_irqrestore(&icc_event_slot.lock, flags);
+}
+EXPORT_SYMBOL_GPL(bpcie_icc_unregister_event_handler);
+
+/* Hard-IRQ context. Returns true if a registered handler took the event. */
+static bool icc_event_dispatch(struct bpcie_dev *sc, struct icc_message_hdr *msg)
+{
+	u8 data[BPCIE_ICC_EVENT_DATA_MAX];
+	unsigned long flags;
+	int len;
+	bool handled = false;
+
+	len = (int)msg->length - (int)ICC_HDR_SIZE;
+	if (len < 0)
+		len = 0;
+	if (len > BPCIE_ICC_EVENT_DATA_MAX)
+		len = BPCIE_ICC_EVENT_DATA_MAX;
+
+	spin_lock_irqsave(&icc_event_slot.lock, flags);
+	if (icc_event_slot.used && icc_event_slot.major == msg->major) {
+		memcpy_fromio(data, REPLY + ICC_HDR_SIZE, len);
+		icc_event_slot.fn(icc_event_slot.ctx, msg->minor, data, len);
+		handled = true;
+	}
+	spin_unlock_irqrestore(&icc_event_slot.lock, flags);
+	return handled;
+}

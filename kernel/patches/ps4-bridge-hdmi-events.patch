+	INIT_DELAYED_WORK(&mn_bridge->hdmi_work, ps4_bridge_hdmi_work);
+	mn_bridge->hdmi_status = connector_status_unknown;
 
 	mn_bridge->encoder = encoder;
 	mn_bridge->connector = connector;
@@ -1219,5 +1330,7 @@ int ps4_bridge_register(struct drm_connector *connector,
 
 	g_bridge = mn_bridge;
 
+	ps4_bridge_events_start(dev, mn_bridge);
+

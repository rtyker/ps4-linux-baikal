+/* Process context: tell userspace and, if the cable is back, re-program the pipe. */
+static void ps4_bridge_hdmi_work(struct work_struct *work)
+{
+	struct ps4_bridge *mn_bridge =
+		container_of(work, struct ps4_bridge, hdmi_work.work);
+	struct drm_connector *connector = mn_bridge->connector;
+	int status = READ_ONCE(mn_bridge->hdmi_status);
+
+	pr_info("ps4_bridge: hdmi %s\n",
+		status == connector_status_connected ? "plug" : "unplug");
+
+	drm_kms_helper_connector_hotplug_event(connector);
+
+	/*
+	 * After a replug the EDID and the mode are unchanged, so the next
+	 * setcrtc from userspace is taken for a plain page flip and never
+	 * re-runs the bridge enable sequence: black screen. A full modeset of
+	 * the enabled CRTCs does (same fix as striker91n/ps4-linux-7.3).
+	 */
+	if (status == connector_status_connected)
+		drm_helper_resume_force_mode(connector->dev);
+}
+
+/* Hard-IRQ context (called from the ICC interrupt): no sleeping here. */
+static void ps4_bridge_hdmi_event(void *ctx, u16 minor, const u8 *data,
+				  u16 length)
+{
+	struct ps4_bridge *mn_bridge = ctx;
+
+	if (length < PS4_BRIDGE_EVENT_HEADER_SIZE ||
+	    data[0] != PS4_BRIDGE_ICC_SERVICE)
+		return;
+
+	switch (data[1]) {
+	case PS4_BRIDGE_EVENT_UNPLUG:
+		WRITE_ONCE(mn_bridge->hdmi_status, connector_status_disconnected);
+		mod_delayed_work(system_wq, &mn_bridge->hdmi_work, 0);
+		break;
+	case PS4_BRIDGE_EVENT_PLUG:
+		WRITE_ONCE(mn_bridge->hdmi_status, connector_status_connected);
+		mod_delayed_work(system_wq, &mn_bridge->hdmi_work,
+				 msecs_to_jiffies(PS4_BRIDGE_PLUG_SETTLE_MS));
+		break;
+	}
+}
+
+/* ICC queue command major 5 / minor 4: turn the bridge's HDMI events on/off. */
+static int ps4_bridge_set_event_control(struct ps4_bridge *mn_bridge, u8 enable)
+{
+	int ret;
+
+	mutex_lock(&mn_bridge->mutex);
+	cq_init(&mn_bridge->cq, 4);
+	cq_cmd(&mn_bridge->cq, 5, 4);
+	*mn_bridge->cq.p++ = enable;
+	ret = cq_exec(&mn_bridge->cq);
+	mutex_unlock(&mn_bridge->mutex);
+
+	return ret < 0 ? ret : 0;
+}
+
+static void ps4_bridge_events_stop(void *data)
+{
+	struct ps4_bridge *mn_bridge = data;
+
+	if (!mn_bridge->hdmi_events)
+		return;
+
+	bpcie_icc_unregister_event_handler(PS4_BRIDGE_ICC_SERVICE);
+	cancel_delayed_work_sync(&mn_bridge->hdmi_work);
+	mn_bridge->hdmi_events = false;
+}
+
+static void ps4_bridge_events_start(struct device *dev,
+				    struct ps4_bridge *mn_bridge)
+{
+	if (bpcie_status() != 1)
+		return;
+
+	if (bpcie_icc_register_event_handler(PS4_BRIDGE_ICC_SERVICE,
+					     ps4_bridge_hdmi_event, mn_bridge))
+		return;
+
+	mn_bridge->hdmi_events = true;
+	if (devm_add_action_or_reset(dev, ps4_bridge_events_stop, mn_bridge))
+		return;
+
+	if (ps4_bridge_set_event_control(mn_bridge, 1))
+		DRM_ERROR("ps4_bridge: failed to enable hdmi events\n");
+}
+

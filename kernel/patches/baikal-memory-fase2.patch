+/*
+ * Layout de /dev/baikal-memory (Fase 2).
+ *
+ * O offset 0 do BAR5 está zerado neste console; os dados reais (bootparams/MAC,
+ * região spm.icc) ficam em offsets altos do BAR5. Por isso o dispositivo de
+ * caractere expõe janelas de BARs diferentes em offsets próprios:
+ *
+ *   0x000000-0x000fff  BAR0 (4 KiB, MMIO de controle)
+ *   0x001000-0x003fff  BAR2 (primeiros 4 MiB da SPM DDR3)
+ *   0x500000-0x53ffff  BAR5 (256 KiB, tabela estruturada)
+ *
+ * BAR4 fica de fora por ora (todo zero ao vivo, sem dados úteis).
+ */
+#define BAILAK_DEV_BAR0_OFF	0x000000ULL
+#define BAILAK_DEV_BAR2_OFF	0x001000ULL
+#define BAILAK_DEV_BAR2_WIN	SZ_4M
+#define BAILAK_DEV_BAR5_OFF	0x00500000ULL
+#define BAILAK_DEV_SIZE		(BAILAK_DEV_BAR5_OFF + BAR5_SIZE)
+

+/*
+ * Resolve um offset de /dev/baikal-memory para o BAR correspondente.
+ * Retorna o ponteiro virtual e, em *avail, quantos bytes ainda são legíveis
+ * de forma contígua a partir dele. Retorna NULL no fim do dispositivo.
+ */
+static void __iomem *baikal_mem_resolve(struct baikal_mem_dev *dev, loff_t pos,
+					size_t *avail)
+{
+	if (pos < BAIKAL_DEV_BAR0_OFF + BAR0_SIZE) {
+		if (!dev->bar0_mapped)
+			return NULL;
+		*avail = BAIKAL_DEV_BAR0_OFF + BAR0_SIZE - pos;
+		return dev->bar0 + (pos - BAIKAL_DEV_BAR0_OFF);
+	}
+
+	if (pos < BAIKAL_DEV_BAR2_OFF + BAIKAL_DEV_BAR2_WIN) {
+		if (!dev->bar2_mapped)
+			return NULL;
+		*avail = BAIKAL_DEV_BAR2_OFF + BAIKAL_DEV_BAR2_WIN - pos;
+		return dev->bar2 + (pos - BAIKAL_DEV_BAR2_OFF);
+	}
+
+	if (pos < BAIKAL_DEV_SIZE) {
+		if (!dev->bar5_mapped)
+			return NULL;
+		*avail = BAIKAL_DEV_SIZE - pos;
+		return dev->bar5 + (pos - BAIKAL_DEV_BAR5_OFF);
+	}
+
+	return NULL;
+}

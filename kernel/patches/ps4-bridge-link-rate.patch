diff --git a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
index ac30fbf42..9b335a9b7 100644
--- a/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
+++ b/drivers/gpu/drm/amd/amdgpu/ps4_bridge.c
@@ -501,6 +501,26 @@ static void ps4_bridge_pre_enable(struct drm_bridge *bridge)
 	cq_writereg(&mn_bridge->cq, 0x7016,0x04);
 #endif
 
+
+	/* Passo 2 do plano DP: ajustar link rate para 2.7 Gbps se o sink suportar.
+	 * O DPCD lido no get_modes mostra MAX_LINK_RATE=0x14 (5.4 Gbps) e 4 lanes.
+	 * O amdgpu_atombios_dp_get_dp_link_config escolhe 162000 (1.62 Gbps) por ser
+	 * o primeiro que satisfaz o pixel clock. Forcamos 270000 (2.7 Gbps) para
+	 * melhor qualidade de sinal e margem de clock recovery.
+	 */
+	if (mn_bridge->connector && mn_bridge->encoder) {
+		struct drm_connector *connector = mn_bridge->connector;
+		struct amdgpu_connector *amdgpu_connector = to_amdgpu_connector(connector);
+		struct amdgpu_connector_atom_dig *dig_connector = amdgpu_connector->con_priv;
+		if (dig_connector && dig_connector->dpcd[0] >= 0x11) {
+			unsigned max_link_rate = drm_dp_max_link_rate(dig_connector->dpcd);
+			if (max_link_rate >= 270000) {
+				DRM_DEBUG_KMS("ps4_bridge: overriding dp_clock %u -> 270000 (max_link_rate=%u)\n",
+				dig_connector->dp_clock, max_link_rate);
+				dig_connector->dp_clock = 270000;
+			}
+		}
+	}
 	/* Disable InfoFrames */
 	cq_writereg(&mn_bridge->cq, INFENA, 0x00);
 	/* Reset HDCP */

diff --git a/drivers/net/ethernet/sony/Kconfig b/drivers/net/ethernet/sony/Kconfig
new file mode 100644
index 000000000..2bf22c8fd
--- /dev/null
+++ b/drivers/net/ethernet/sony/Kconfig
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: GPL-2.0
+config NET_VENDOR_SONY
+	bool "Sony devices"
+	default y
+	depends on PCI && X86_PS4
+	help
+	  Suporte a dispositivos de rede dos southbridges Sony (PS4).
+
+if NET_VENDOR_SONY
+
+config MTS_GBE
+	tristate "Sony Baikal GBE (MTS) support"
+	depends on PCI && X86_PS4_BAIKAL
+	select CRC32
+	help
+	  Driver para a Gigabit Ethernet do southbridge Baikal (PS4 Pro),
+	  que usa o controlador MTS -- NAO e um Marvell Yukon, entao o
+	  driver sky2 nao serve.
+
+config MTSX
+	tristate "Sony Baikal GBE (MTS) firmware-based driver"
+	depends on PCI && X86_PS4_BAIKAL
+	help
+	  Driver para a Gigabit Ethernet do southbridge Baikal (PS4 Pro) que
+	  adota o MAC/PHY exatamente como o firmware do Orbis deixou apos o
+	  kexec: sem cold init, sem calibracao de PHY e sem glue reset.
+
+	  Nao tem MODULE_DEVICE_TABLE de proposito: so carrega por
+	  `modprobe mtsx` (ou `insmod` explicito, como na Fase C). O driver
+	  legado MTS_GBE disputa o mesmo device PCI, entao precisa ficar
+	  bloqueado (`blacklist mts` no rootfs).
+
+	  Ver others/docs/PLAN_ETH0_BAIKAL.md (Fases A-C) e
+	  kernel/drivers_mts/mtsx.c.
+
+endif # NET_VENDOR_SONY
diff --git a/drivers/net/ethernet/sony/Makefile b/drivers/net/ethernet/sony/Makefile

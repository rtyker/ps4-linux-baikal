# ============================================================
# PS4 Linux Baikal — .gitignore
# Focado em: kernel Baikal + driver MTS + Mesa PS4 patchado
# ============================================================

# --- Temporários ---
*.log
*.tmp
__pycache__/
.megatmp.*
netconsole_ps4.log
dmesg.log

# --- Segredos e Chaves de Hardware (Não compartilhar) ---
.env
*.env
.env.keys
keys/

# --- Dumps/binários brutos ---
*.tar
*.tar.xz
*.tar.gz
*.tar.zst
*.zip
dummy_mem.bin
fake_mem

# --- Dumps de firmware proprietário (kernel Orbis/Ghidra) ---
consolidado/dumps_orbis/
consolidado/memoriateste.bin

# --- Logs de hardware/capturas UART (grandes e efêmeros) ---
tests/uart_logs/
dmesg_output/
netconsole_ps4_captures/

# --- IDE/ambiente ---
.claude/
.claude-memory.yml
.opencode/
opencode.json
.vscode/
.DS_Store
*.swp
*.swo

# ============================================================
# PROJETOS IGNORADOS (não são do Baikal)
# ============================================================
old_project/
OpenOrbis/
all-ps4-payloads/
archive/
gbe_hw_dumper/
kmem_dumper_sources/
orbis-hw-dumper/
ps4-linux-payloads/
ps4-payload-sdk/
ps4-pup-unpacker/
scene-kernel-dumper/
scene-kmem-dumper/
initramfs/
kernel-framework-local/
kernels/
drivers/
distros/Steam4PS/
distros/winesapos/

# ============================================================
# BUILD ARTIFACTS (recuperáveis via build)
# ============================================================

# Kernel build outputs
distros/arch_minimal_v2/boot_referencia/
distros/arch_minimal_v2/arch_minimal_v2-7.0.tar
distros/arch_minimal_v2/systemd_cache/
distros/arch_minimal_v2/logs/
distros/arch_minimal_v2/extra_firmware/

# RELEASE — artefatos compilados
# v1.0.0 (versão de distribuição) é versionada; demais tags são build output local.
RELEASE/*
!RELEASE/README.md
!RELEASE/v1.0.0/

# MTS module build
drivers_mts/build/

# Mesa build
mesa-26.1.5/
mesa-26.1.5.tar.xz
mesa/build_artifacts/
mesa/*.tar.xz
mesa/*.tar.gz
mesa/*.tar.zst
mesa/*.zip

# Ghidra project
consolidado/tools/ghidra_project/
